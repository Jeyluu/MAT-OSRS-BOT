{
  "name": "merch-bot",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "scripts": {
    "build": "npm run build:core && nest build",
    "build:core": "npm run build --workspace=@osrs-helper/core",
    "dev:web": "npm run build:core && npm run refresh:market && npm run dev --workspace=@osrs-helper/web",
    "refresh:market": "node apps/web/scripts/refresh-osrs-market.mjs",
    "build:web": "npm run build:core && npm run build --workspace=@osrs-helper/web",
    "preview:web": "npm run preview --workspace=@osrs-helper/web",
    "test:web": "npm run test --workspace=@osrs-helper/web",
    "check:web": "npm run check --workspace=@osrs-helper/web",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build:core && nest start",
    "start:dev": "npm run build:core && nest start --watch",
    "start:debug": "npm run build:core && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "npm run build:core && jest",
    "test:watch": "npm run build:core && jest --watch",
    "test:cov": "npm run build:core && jest --coverage",
    "test:debug": "npm run build:core && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run build:core && jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@osrs-helper/core": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "discord.js": "^14.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
