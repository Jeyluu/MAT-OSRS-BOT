# HTTP port used by the NestJS application.
PORT=3000

# Discord application credentials.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional development server where slash commands are available immediately.
DISCORD_GUILD_ID=

# Set ALERTS_ENABLED=true and a target channel ID to enable Discord alerts.
ALERTS_ENABLED=true
ALERTS_DISCORD_CHANNEL_ID=1539595504273465426
ALERTS_INTERVAL_MS=60000
ALERTS_MAX_PER_RUN=3
ALERTS_DEDUP_TTL_MS=3600000

# OSRS Wiki real-time prices API configuration.
OSRS_WIKI_PRICES_BASE_URL=https://prices.runescape.wiki/api/v1/osrs
OSRS_WIKI_PRICES_USER_AGENT=MAT-OSRS-BOT/1.0 (GitHub: https://github.com/Jeyluu/MAT-OSRS-BOT)
OSRS_WIKI_PRICES_CACHE_TTL_MS=60000
OSRS_WIKI_MAPPING_CACHE_TTL_MS=86400000
OSRS_WIKI_PRICES_REQUEST_TIMEOUT_MS=10000

# Merch opportunity filters. All prices are in GP and quote age is in milliseconds.
OPPORTUNITIES_MIN_BUY_PRICE=1000
OPPORTUNITIES_MIN_PROFIT_PER_ITEM=1000
OPPORTUNITIES_MIN_ROI_PERCENT=2
OPPORTUNITIES_MAX_PRICE_AGE_MS=900000
OPPORTUNITIES_MIN_BUY_LIMIT=1
OPPORTUNITIES_MAX_RESULTS=25
OPPORTUNITIES_INCLUDE_MEMBERS=true

# Current Grand Exchange tax. Add any additional tax-exempt item IDs as CSV.
OPPORTUNITIES_GE_TAX_RATE=0.02
OPPORTUNITIES_GE_TAX_CAP=5000000
OPPORTUNITIES_GE_TAX_EXEMPT_ITEM_IDS=
